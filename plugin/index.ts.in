// Generated by the installer. Local access token is added only on this machine.
export default {
  id: "zen-free-rotation",
  async setup(ctx) {
    await ctx.session.hook("model.request", (event) => {
      if (event.model.providerID === "opencode" && event.model.id.endsWith("-free")) {
        event.baseURL = __BASE_URL__;
        event.headers["x-zen-rotator-token"] = __LOCAL_TOKEN__;
      }
    });
  },
};
